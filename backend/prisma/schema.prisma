// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  passwordHash       String
  displayName        String
  gender             String
  age                Int
  height             Int?
  origin             String?
  twoFactorSecret    String?
  twoFactorEnabled   Boolean             @default(false)
  role               String              @default("USER") // "USER" | "ADMIN"
  plan               String              @default("FREE") // "FREE" | "PREMIUM"
  tier               String              @default("FREE")
  resetToken         String?
  resetTokenExpires  DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  
  profilePreferences ProfilePreference?
  dailyCheckIns      DailyCheckIn[]
  recommendations    Recommendation[]
  streak             Streak?
  userBadges         UserBadge[]
  musicRecommendations MusicRecommendation[]
  musicFeedbacks     MusicFeedback[]
  dailyMoodQuestionnaires DailyMoodQuestionnaire[]
  sentimentScans     SentimentScan[]
}

model ProfilePreference {
  userId           Int      @id
  styleTags        Json     @default("[]")
  colorPreferences Json     @default("[]")
  musicPreferences Json     @default("[]")
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyCheckIn {
  id             Int      @id @default(autoincrement())
  userId         Int
  checkinDate    DateTime @default(now()) @db.Date
  moodDetected   String
  moodSelected   String
  answers        Json
  imageUrl       String?
  transcript     String?
  aiVoiceMessage String?
  createdAt      DateTime @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
  musicRecommendations MusicRecommendation[]

  @@unique([userId, checkinDate])
}

model MusicRecommendation {
  id               Int       @id @default(autoincrement())
  userId           Int
  dailyCheckInId   Int?
  recommendationDate DateTime @default(now()) @db.Date
  moodPrincipal    String
  niveauEnergie    String
  contexte         String?
  spotifySeedGenres Json
  spotifyValence   Float
  spotifyEnergy    Float
  spotifyDanceability Float?
  spotifyAcousticness Float?
  tracks           Json
  createdAt        DateTime  @default(now())

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckIn     DailyCheckIn? @relation(fields: [dailyCheckInId], references: [id], onDelete: SetNull)
  feedbacks        MusicFeedback[]
}

model DailyMoodQuestionnaire {
  id             Int      @id @default(autoincrement())
  userId         Int
  date           DateTime @db.Date
  humeurDetectee String
  niveauEnergie  String
  contexte       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MusicFeedback {
  id                    Int      @id @default(autoincrement())
  userId                Int
  musicRecommendationId Int
  trackId               String
  liked                 Boolean
  createdAt             DateTime @default(now())

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  musicRecommendation   MusicRecommendation @relation(fields: [musicRecommendationId], references: [id], onDelete: Cascade)
}

model MusicFallbackPlaylist {
  id            Int      @id @default(autoincrement())
  moodPrincipal String
  name          String
  tracks        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([moodPrincipal])
}

model Recommendation {
  id                 Int      @id @default(autoincrement())
  userId             Int
  checkinId          Int
  recommendationDate DateTime @default(now()) @db.Date
  outfits            Json
  makeup             Json
  music              Json
  feedbackPositive   Boolean?
  createdAt          DateTime @default(now())

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckIn       DailyCheckIn  @relation(fields: [checkinId], references: [id], onDelete: Cascade)
}

model Streak {
  userId               Int       @id
  currentStreak        Int       @default(0)
  maxStreak            Int       @default(0)
  lastCheckinDate      DateTime? @db.Date
  weeklyFreezeUsedDate DateTime? @db.Date
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  description String
  icon        String       @default("✨")
  criteria    Json

  userBadges  UserBadge[]
}

model UserBadge {
  userId      Int
  badgeId     Int
  progress    Int      @default(0)
  unlockedAt  DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

model SentimentScan {
  id              Int      @id @default(autoincrement())
  userId          Int
  dominantEmotion String
  verdict         String
  indicators      Json
  facialReading   String
  conseilAura     String
  imageUrl        String?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemConfig {
  id                      Int      @id @default(1)
  premiumPriceMad         Float    @default(99.0)
  isTryOnPremium          Boolean  @default(true)
  isBeautyPremium         Boolean  @default(true)
  isVoicePremium          Boolean  @default(true)
  isSentimentsPremium     Boolean  @default(false)
  isMusicPremium          Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}
